# Configurações do Google Firebase para Sincronização em Tempo Real
# Copie os valores do console do Firebase (Configurações do Projeto > Seus Aplicativos > Web)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# Configurações do Open Finance Pluggy (Configurar nas Environment Variables da Vercel)
# Obtenha em https://dashboard.pluggy.ai (Menu Aplicação)
PLUGGY_CLIENT_ID="seu_client_id_aqui"
PLUGGY_CLIENT_SECRET="seu_client_secret_aqui"
